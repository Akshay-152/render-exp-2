# Cloudinary
CLOUD_NAME=your_cloud_name
UPLOAD_PRESET=your_upload_preset

# Firebase
FIREBASE_API_KEY=your_firebase_api_key
FIREBASE_PROJECT_ID=your_project_id

# Spotify (optional)
SPOTIFY_CLIENT_ID=your_spotify_client_id
SPOTIFY_CLIENT_SECRET=your_spotify_secret

# Owner ID
OWNER_ID=user_4919

# Optional
MAX_WORKERS=5

# --- YouTube authentication (REQUIRED for Render / datacenter IPs) ---
# Choose ONE of these. On Render, COOKIES_BASE64 is the recommended option
# (set it as a Render Secret, not committed to the repo).
#
# 1) Path to a Netscape-format cookies.txt file (works in Docker if mounted).
#    First line must be:  # HTTP Cookie File
COOKIES_FILE=

# 2) Base64-encoded cookies.txt content. Render Secret. Decoded at startup
#    into ./cookies.txt. Do NOT commit the raw cookies.
#    Generate:  base64 -w0 cookies.txt
COOKIES_BASE64=

# 3) Browser profile to read cookies from (LOCAL use only; headless Docker on
#    Render has no browser, so this is impossible there).
COOKIES_FROM_BROWSER=

# --- Retry / rate-limit tuning (optional) ---
MAX_RETRIES=3
BASE_BACKOFF=2.0
MAX_BACKOFF=30.0
TRACK_DELAY=1.0

# Set to 1 to enable verbose debug logging (options, extractor args, etc.)
DEBUG=0
